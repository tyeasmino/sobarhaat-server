# MongoDB connection string (same Atlas cluster the Next.js app uses)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/sobarhaat

# Must match the client's BETTER_AUTH_URL exactly — it is the JWT issuer and
# audience. The JWKS is fetched from the CLIENT origin, not this API.
BETTER_AUTH_URL=http://localhost:3000

# Explicit client origin used for the JWKS URL. On Vercel this defaults to
# https://sobarhaat-client.vercel.app, so it only needs setting when the client
# is deployed somewhere else.
CLIENT_URL=http://localhost:3000

# Comma-separated origins allowed to call this API with credentials.
# Defaults cover localhost and https://sobarhaat-client.vercel.app.
# Set this only when deploying the client to a different origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sobarhaat-client.vercel.app

# Express port for local development (Vercel serverless does not use it)
PORT=8000
